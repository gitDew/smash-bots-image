# PRIVATE ADMIN CONFIGURATION — never commit .env.event or distribute it to a team.
# `make init-event` copies this template, reusing your existing model key if available.
# Fill in the four GitHub tokens below. Values are literal; no shell interpolation.

IMAGE_PREFIX=ghcr.io/gitdew/smash-bots-image
IMAGE_TAG=v0.1.0

LLM_PROVIDER=opencode-go
LLM_MODEL=kimi-k2.6
LLM_THINKING=medium
OPENCODE_API_KEY=replace-with-model-api-key
# Alternative providers use OPENAI_API_KEY, ANTHROPIC_API_KEY, or OPENROUTER_API_KEY.

TEAM_A_REPO_URL=https://github.com/gitDew/smash-team-a.git
TEAM_A_BRANCH=main
TEAM_A_GITHUB_TOKEN=replace-with-team-a-token
TEAM_A_PLATFORM=linux/amd64

TEAM_B_REPO_URL=https://github.com/gitDew/smash-team-b.git
TEAM_B_BRANCH=main
TEAM_B_GITHUB_TOKEN=replace-with-team-b-token
TEAM_B_PLATFORM=linux/amd64

TEAM_C_REPO_URL=https://github.com/gitDew/smash-team-c.git
TEAM_C_BRANCH=main
TEAM_C_GITHUB_TOKEN=replace-with-team-c-token
TEAM_C_PLATFORM=linux/amd64

TEAM_D_REPO_URL=https://github.com/gitDew/smash-team-d.git
TEAM_D_BRANCH=main
TEAM_D_GITHUB_TOKEN=replace-with-team-d-token
TEAM_D_PLATFORM=linux/arm64
