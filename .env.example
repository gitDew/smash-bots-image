# Administrator-only. Copy to .env (chmod 600); never commit or bake into an image.
# One configuration/Compose project per laptop/team. Repositories contain bot.py at root.
TEAM_ID=team_a
TEAM_REPO_URL=https://github.com/YOUR-ORG/smash-team-a.git
TEAM_BRANCH=main

# Fine-grained, expiring token: Contents read/write for THIS repository only.
GITHUB_TOKEN=replace-with-team-repository-token

# Existing OpenCode Go setup. The model must exist in Pi 0.84.4's bundled catalog.
LLM_PROVIDER=opencode-go
LLM_MODEL=kimi-k2.6
LLM_THINKING=medium
OPENCODE_API_KEY=replace-with-opencode-api-key

# Alternatives (set LLM_PROVIDER and LLM_MODEL, then the corresponding key):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1
# OPENAI_API_KEY=
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_API_KEY=
# OpenCode Zen uses LLM_PROVIDER=opencode and OPENCODE_API_KEY.

IMAGE_PREFIX=smash-bots
IMAGE_TAG=dev
